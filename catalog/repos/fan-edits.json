{
  "schema": "relay.catalog-repo.v1",
  "repo": "fan-edits",
  "description": "Flashback Repository \u2014 personal fan-edit library over thin IPFS media (own the original).",
  "tier": "primary",
  "forge_url": "https://gitlab.com/clevertree/fan-edits.git",
  "relay_root_commit": "5520889bd9e6d683a3bbc83b47b3950bd00c8dcd",
  "publish_branch": "main",
  "publish_origin": "iad1.relaygateway.net",
  "signing_keys_source": "repo",
  "domains": [
    "flashbackrepository.org",
    "www.flashbackrepository.org"
  ],
  "branch_features": {
    "comments": {
      "enabled": true,
      "branch_name": "comments",
      "path_root": ".relay/comments/by-path/",
      "allow_unsigned_commits": true,
      "require_signed_commits": false,
      "format": "markdown"
    },
    "dev": {
      "enabled": true,
      "branch_name": "dev",
      "allow_unsigned_commits": true
    }
  },
  "limits": {
    "allow_binary_files": false,
    "thin_ipfs_assets": true,
    "fleet_pin_ipfs": false,
    "max_ipfs_bytes": 0
  },
  "notes": "Thin IPFS catalog only (stubs + manifest). Fleet does not pin or disk-cache feature MKVs — APK/browser pull CIDs from the swarm. Now showing = manual host upload. Board on comments; drafts on dev."
}
